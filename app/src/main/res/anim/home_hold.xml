<?xml version="1.0" encoding="utf-8"?>
<!-- 앱이 커지는 동안 홈은 제자리에서 살짝 물러남 -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale android:fromXScale="1" android:toXScale="0.94" android:fromYScale="1" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="50%" android:duration="500"
        android:interpolator="@android:interpolator/decelerate_cubic" />
    <alpha android:fromAlpha="1" android:toAlpha="0.6" android:duration="500" />
</set>
